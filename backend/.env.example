# Copiar como backend/.env y completar. NUNCA subir el .env real al repositorio.
# Los tres servicios leen este mismo archivo.

# ---------- API Gateway (HTTP) ----------
PORT=3000
USER_SERVICE_HOST=127.0.0.1
USER_SERVICE_PORT=3001
MARKET_SERVICE_HOST=127.0.0.1
MARKET_SERVICE_PORT=3002
# Orígenes del frontend, separados por comas (obligatorio en producción).
# Sin configurar: http://localhost:5173 y http://127.0.0.1:5173.
# CORS_ORIGINS=https://allpets.example
# Cantidad de proxies propios delante del gateway (nginx, balanceador). Sin proxy, no definirla.
# TRUST_PROXY_HOPS=1
# Límite de peticiones compartido entre gateways. Sin configurar queda en memoria.
# REDIS_URL=redis://127.0.0.1:6379

# ---------- Core User Service (TCP) ----------
PORT_USER_SERVICE_TCP=3001
# Interfaz donde escucha el TCP (sin autenticación). Por defecto solo esta máquina;
# en contenedores usar 0.0.0.0 únicamente dentro de una red privada.
# USER_SERVICE_BIND_HOST=127.0.0.1
MONGO_URI_USERS=mongodb://127.0.0.1:27017/allpets_users
JWT_EXPIRATION=7d
# Secreto largo y aleatorio. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Clave AES-256-GCM (base64 de 32 bytes) para cifrar teléfonos. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PHONE_ENCRYPTION_KEY=

# ---------- Market Service (TCP) ----------
PORT_MARKET_SERVICE_TCP=3002
# MARKET_SERVICE_BIND_HOST=127.0.0.1
MONGO_URI_MARKET=mongodb://127.0.0.1:27017/allpets

# ---------- Swagger en producción (opcional) ----------
# NODE_ENV=production
# SWAGGER_ENABLED=true
# SWAGGER_USER=
# SWAGGER_PASSWORD=
